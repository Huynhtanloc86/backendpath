# ========================
# Python / Backend
# ========================
backend/.venv/
backend/__pycache__/
backend/**/__pycache__/
backend/**/*.pyc
backend/**/*.pyo
backend/.pytest_cache/
backend/test_backendpath.db
backend/*.egg-info/
backend/dist/
backend/build/

# Không commit .env thật - chỉ commit .env.example
backend/.env
# Giữ lại .env.example để người clone biết cần đặt biến gì
!backend/.env.example

# Alembic compiled cache (không cần commit)
backend/alembic/**/__pycache__/

# ========================
# Node.js / Frontend
# ========================
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/dist/
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local

# npm/yarn logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ========================
# IDE / Editor
# ========================
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ========================
# Docker
# ========================
# Không ignore docker-compose.yml - cần commit để mọi người biết cách chạy

# ========================
# Misc
# ========================
*.log
.coverage
htmlcov/
